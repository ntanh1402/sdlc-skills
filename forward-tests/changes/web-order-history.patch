+
+export type Order = { orderId: string; totalUsd: number; status: string; createdAt: string };
+
+/** GET /orders?customerId=: the customer's own orders, newest first. */
+export async function listOrders(session: string, customerId: string): Promise<Order[]> {
+  const response = await fetch(`${ORDERS_URL}/orders?customerId=${customerId}&limit=50`, {
+    headers: { Authorization: `Bearer ${session}` },
+  });
+  if (!response.ok) {
+    throw new Error(`could not load orders: ${response.status}`);
+  }
+  return (await response.json()).orders;
+}
