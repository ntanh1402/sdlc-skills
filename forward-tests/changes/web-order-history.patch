+import { useEffect, useState } from "react";
+import { listOrders, Order } from "../api/orders";
+import { useSession } from "../state";
+
+/** /orders: the customer's order history. Needs a login. */
+export default function Orders() {
+  const session = useSession({ redirectTo: "/login?return=/orders" });
+  const [orders, setOrders] = useState<Order[] | null>(null);
+
+  useEffect(() => {
+    listOrders(session.token, session.customerId).then(setOrders);
+  }, [session.token, session.customerId]);
+
+  if (orders === null) return <p>Loading your orders…</p>;
+  if (orders.length === 0) return <p>You have no orders yet.</p>;
+  return <OrderList orders={orders} />;
+}
