diff --git a/src/main/java/com/acme/orders/OrderController.java b/src/main/java/com/acme/orders/OrderController.java
index 8d2ad87..aca9437 100644
--- a/src/main/java/com/acme/orders/OrderController.java
+++ b/src/main/java/com/acme/orders/OrderController.java
@@ -65,4 +65,18 @@ public class OrderController {
             case VENDOR_FAILED -> ResponseEntity.status(502).build();
         };
     }
+
+    public record Refund(String reason) {}
+
+    /** POST /orders/{id}/refund: refunds an order in full. */
+    @PostMapping("/{id}/refund")
+    public ResponseEntity<?> refund(@PathVariable UUID id, @RequestBody(required = false) Refund body) {
+        String reason = body == null ? null : body.reason();
+        if (reason != null && reason.length() > 200) {
+            return ResponseEntity.unprocessableEntity().build();
+        }
+        return orders.refund(id, reason)
+                ? ResponseEntity.ok(Map.of("orderId", id, "status", "refunded"))
+                : ResponseEntity.notFound().build();
+    }
 }
